# ---- Frontend environment (copy to .env for local dev) ----
# Vite inlines these at BUILD time. In CI they come from GitHub repo Variables,
# not this file. Point them at the PUBLIC backend URL (HTTPS, see note below).
#
# NOTE: the app reads BOTH of these (axios calls use VITE_API_URL, the socket
# client uses VITE_SOCKET_URL). Set both even though they're usually the same host.
#
# Because the site is served over HTTPS (CloudFront), the backend MUST also be
# HTTPS — otherwise the browser blocks "mixed content". Use the backend's TLS URL.

VITE_API_URL=https://api.yourdomain.com
VITE_SOCKET_URL=https://api.yourdomain.com

# ---- VdoCipher player theme (optional) ----
# The video control bar and the quality menu are drawn by VdoCipher inside a
# cross-origin iframe, so they cannot be restyled from our code. To get a
# simplified control set and resolution labels (360p / 720p HD / 1080p Full HD)
# instead of raw bitrate values (400 / 1000 / 2000 kbps):
#
#   1. VdoCipher dashboard -> Config -> Players -> create/edit a player
#   2. Choose the controls to show and switch quality display to resolutions
#   3. Copy that player's id here
#
# Leave blank to use the VdoCipher account's default player.
VITE_VDOCIPHER_PLAYER_ID=
